  <diagram id="db-rules" name="15 — Quy ước và ràng buộc xuyên bảng">
    <mxGraphModel dx="6609" dy="2013" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="db3922" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;" value="Quy ước và ràng buộc cần đọc cùng sơ đồ" vertex="1">
          <mxGeometry height="60" width="2500" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="db3923" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Nguồn duy nhất cho cấu trúc chi tiết: Database/Edumy_Database.dbml. Đây là snapshot, không phải xác minh database đang chạy." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="135" as="geometry" />
        </mxCell>
        <mxCell id="db3924" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="User–Role có quan hệ n.n được hiện thực bởi AspNetUserRoles(UserId, RoleId), không đưa thêm bảng nối vào 55 lớp." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="235" as="geometry" />
        </mxCell>
        <mxCell id="db3925" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Enrollment: PK(UserId, CourseId). ExamEnrollment: PK(UserId, ExamId). EnrollmentSectionCompletion có FK ghép về Enrollment và unique theo UserId/CourseId/SectionId." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="335" as="geometry" />
        </mxCell>
        <mxCell id="db3926" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="CourseEssayAssignment: tối đa một bài chưa xóa cho mỗi khóa học theo partial unique. Lịch sử vẫn có thể nhiều bản ghi." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="435" as="geometry" />
        </mxCell>
        <mxCell id="db3927" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="CourseEssaySubmission: tối đa một bài Pending chưa xóa cho mỗi AssignmentId/StudentId; kiểm tra tính nhất quán người chấm, thời điểm chấm và điểm bằng check." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="535" as="geometry" />
        </mxCell>
        <mxCell id="db3928" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Report: đúng một CourseId hoặc ExamId. Certificate có hai FK tùy chọn; không tự thêm XOR." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="635" as="geometry" />
        </mxCell>
        <mxCell id="db3929" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Article, Video, Resource: LessonId unique từng bảng; không suy rằng ba loại nội dung loại trừ nhau khi nguồn không có check tương ứng." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="735" as="geometry" />
        </mxCell>
        <mxCell id="db3930" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="PaymentOrderItem: ItemType + ItemId là snapshot sản phẩm, không có FK đến Course/Exam. Không tự tạo lớp Sản phẩm hoặc FK." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="835" as="geometry" />
        </mxCell>
        <mxCell id="db3931" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="VoucherUsage: PaymentOrderId unique; unique theo trạng thái với UserVoucherId là có điều kiện. VoucherGrantRule: CampaignId unique." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="935" as="geometry" />
        </mxCell>
        <mxCell id="db3932" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="AI: course_id / user_id không có FK đến bảng public thì không vẽ FK. course_indexes và reindex_jobs giữ FK ghép, unique có điều kiện và check trạng thái theo nguồn." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="db3933" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Không dùng CASCADE để suy composition. dbActions metadata lưu ON DELETE / ON UPDATE; FK thiếu liên kết không được bổ sung từ tên cột." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="db3934" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Kiểu cột PostgreSQL giữ nguyên độ dài/precision/scale. Nullable không thay thế CHECK; tên PK/FK/UNIQUE/CHECK và biểu thức đầy đủ nằm trong metadata của lớp." vertex="1">
          <mxGeometry height="85" width="2500" x="50" y="1235" as="geometry" />
        </mxCell>
        <mxCell id="db3935" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;" value="Không có Controller, Service, Repository, DTO hoặc ngăn method. Các lớp chỉ biểu diễn dữ liệu và ràng buộc lưu trữ." vertex="1">
