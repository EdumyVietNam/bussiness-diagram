                </mxCell>
                <mxCell id="c1116" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontSize=26;" value="BỔ SUNG — Thuộc tính và trách nhiệm nghiệp vụ" vertex="1">
