                    <mxGeometry height="425" width="1660" x="50" y="8210" as="geometry"/>
                </mxCell>
                <mxCell id="c1122" parent="1" style="rounded=0;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;strokeColor=#64748b;fillColor=#f8fafc;spacing=16;fontSize=15;" value="&lt;b&gt;Course — public.Courses&lt;/b&gt;&lt;br&gt;&lt;br&gt;Id → Lược: định danh / hạ tầng&lt;br&gt;BusinessStatus → Trạng thái nghiệp vụ: Integer&lt;br&gt;CourseTypeId → Liên kết&lt;br&gt;CreatedAt → Ngày tạo: DateTime&lt;br&gt;CreatorId → Liên kết&lt;br&gt;Description → Mô tả: String [0..1]&lt;br&gt;HasCertificate → Có chứng chỉ: Boolean&lt;br&gt;Price → Giá: Money&lt;br&gt;PromotionPrice → Giá khuyến mãi: Money [0..1]&lt;br&gt;ReviewNote → Nhận xét duyệt: String [0..1]&lt;br&gt;ReviewedAt → Ngày duyệt: DateTime [0..1]&lt;br&gt;ReviewedBy → Mã người duyệt: String [0..1]&lt;br&gt;Status → Trạng thái bản ghi: Integer&lt;br&gt;SubjectCategoryId → Liên kết&lt;br&gt;SubmittedAt → Ngày gửi duyệt: DateTime [0..1]&lt;br&gt;TagId → Liên kết&lt;br&gt;ThumbnailUrl → Đường dẫn ảnh bìa: String [0..1]&lt;br&gt;Title → Tiêu đề: String&lt;br&gt;HasEssay → Có tự luận: Boolean [0..1]&lt;br&gt;&lt;br&gt;&lt;b&gt;Thao tác / căn cứ:&lt;/b&gt;&lt;br&gt;+ addSection(title: String, order: Integer): CourseSection&lt;br&gt;+ canSubmitForReview(): Boolean {query}&lt;br&gt;+ submitForReview(): void&lt;br&gt;+ recordReview(approved: Boolean, comment: String [0..1]): void&lt;br&gt;Ca sử dụng: CreateAndManageCourseContent" vertex="1">
