                <mxCell id="c1114" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontSize=16;" value="Liên kết bổ sung có nguồn nghiệp vụ: phiên AI–người dùng, phiên AI–khóa học, chỉ mục–khóa học, yêu cầu cập nhật–khóa học. Không phải FK." vertex="1">
