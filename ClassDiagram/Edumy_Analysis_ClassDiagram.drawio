                </mxCell>
                <mxCell id="c1115" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontSize=15;" value="Nguồn giải nghĩa: DBML gốc (partial unique / check), SystemDescription: CourseAiAssistant, ManageAiIndex, CreateAndManageCourseContent, RegisterToBecomeAnInstructor. Không cập nhật snapshot theo mã nguồn mới." vertex="1">
