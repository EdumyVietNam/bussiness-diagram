    (AssignmentId, StudentId, CreatedAt) [name: 'IX_CourseEssaySubmissions_AssignmentId_StudentId_CreatedAt']
    (GradedBy) [name: 'IX_CourseEssaySubmissions_GradedBy']
    (StudentId) [name: 'IX_CourseEssaySubmissions_StudentId']
    (AssignmentId, StudentId) [name: 'UX_CourseEssaySubmissions_OnePending', unique, note: 'Filter: (("GradingResult" = 0) AND ("Status" <> \'-1\'::integer))']
  }
  checks {
    `((("GradingResult" = 0) AND ("GradedBy" IS NULL) AND ("GradedAt" IS NULL) AND ("Score" IS NULL)) OR (("GradingResult" = ANY (ARRAY[1, 2])) AND ("GradedBy" IS NOT NULL) AND ("GradedAt" IS NOT NULL)))` [name: 'CK_CourseEssaySubmissions_Grading']
    `(("Score" IS NULL) OR (("Score" >= (0)::numeric) AND ("Score" <= (10)::numeric)))` [name: 'CK_CourseEssaySubmissions_Score']
    `(length(TRIM(BOTH FROM "SubmissionUrl")) > 0)` [name: 'CK_CourseEssaySubmissions_Url']
  }
}

Table public.Reports {
  Id integer [not null, increment]
  Code varchar(50)
  Content text [not null]
  CourseId integer
  CreatedAt "timestamp with time zone" [not null]
  CreatedBy varchar(255)
  Description text
  ExamId integer
  IsDefault boolean
  Name varchar(255)
  ReportStatus integer [not null, default: `0`]
  ResolutionNote text
  ResolvedAt "timestamp with time zone"
  ResolvedBy varchar(36)
  SortOrder integer
  Status integer [not null]
  UpdatedAt "timestamp with time zone"
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_Reports', pk]
    (CourseId, ReportStatus) [name: 'IX_Reports_CourseId_ReportStatus']
    (ExamId, ReportStatus) [name: 'IX_Reports_ExamId_ReportStatus']
    (ReportStatus, CreatedAt) [name: 'IX_Reports_ReportStatus_CreatedAt']
    (ResolvedBy) [name: 'IX_Reports_ResolvedBy']
    (UserId, CreatedAt) [name: 'IX_Reports_UserId_CreatedAt']
  }
  checks {
    `((("CourseId" IS NOT NULL) AND ("ExamId" IS NULL)) OR (("CourseId" IS NULL) AND ("ExamId" IS NOT NULL)))` [name: 'CK_Reports_ExactlyOneTarget']
  }
}

Table public.test_vector_backup [note: 'Existing auxiliary/backup table in the live database; not an EF application entity.'] {
  id integer [not null, increment]
  course_id integer
  embedding vector(3)
  indexes {
    (id) [name: 'test_vector_backup_pkey', pk]
  }
}

