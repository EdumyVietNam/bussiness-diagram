  ReleasedAt "timestamp with time zone"
  ReservedAt "timestamp with time zone" [not null]
  ReservedUntil "timestamp with time zone"
  Status integer [not null]
  UserId varchar(36) [not null]
  VoucherId integer [not null]
  UserVoucherId bigint
  indexes {
    (Id) [name: 'PK_VoucherUsages', pk]
    (PaymentOrderId) [name: 'IX_VoucherUsages_PaymentOrderId', unique]
    (UserVoucherId, Status) [name: 'IX_VoucherUsages_UserVoucherId_Status', unique, note: 'Filter: ("Status" = ANY (ARRAY[0, 1]))']
    (VoucherId, Status, ReservedUntil) [name: 'IX_VoucherUsages_VoucherId_Status_ReservedUntil']
  }
  checks {
    `("DiscountAmount" >= (0)::numeric)` [name: 'CK_VoucherUsages_DiscountAmount_NonNegative']
  }
}

Table public.Vouchers [note: 'Migration-only expression unique index IX_Vouchers_Code_Normalized on UPPER(BTRIM(Code)).'] {
  Id integer [not null, increment]
  Code varchar(50)
  Condition text
  CreatedAt "timestamp with time zone" [not null]
  CreatedBy varchar(255)
  CurrentUsage integer [not null]
  Description text
  DiscountType integer [not null]
  DiscountValue numeric(18,2) [not null]
  EndDate "timestamp with time zone"
  IsDefault boolean
  MaxDiscountAmount numeric(18,2)
  MaxUsage integer [not null]
  MinOrderAmount numeric(18,2) [not null, default: `0.0`]
  Name varchar(255)
  ReservedUsage integer [not null, default: `0`]
  SortOrder integer
  StartDate "timestamp with time zone"
  Status integer [not null]
  UpdatedAt "timestamp with time zone"
  VoucherTypeId integer [not null]
  indexes {
    (Id) [name: 'PK_Vouchers', pk]
    (Code) [name: 'IX_Vouchers_Code', unique]
    (`upper(btrim("Code"::text))`) [name: 'IX_Vouchers_Code_Normalized', unique, note: 'Filter: ("Code" IS NOT NULL)']
    (Status) [name: 'IX_Vouchers_Status']
    (VoucherTypeId) [name: 'IX_Vouchers_VoucherTypeId']
  }
  checks {
    `(("MaxDiscountAmount" IS NULL) OR ("MaxDiscountAmount" > (0)::numeric))` [name: 'CK_Vouchers_MaxDiscountAmount_NonNegative']
    `(("MaxUsage" = 0) OR (("CurrentUsage" + "ReservedUsage") <= "MaxUsage"))` [name: 'CK_Vouchers_MaxUsage_Quota']
    `("MinOrderAmount" >= (0)::numeric)` [name: 'CK_Vouchers_MinOrderAmount_NonNegative']
    `(("CurrentUsage" >= 0) AND ("ReservedUsage" >= 0))` [name: 'CK_Vouchers_UsageCounters_NonNegative']
  }
}

Table ai.chat_history {
  id uuid [not null]
  answer text [not null]
  answer_basis varchar(32) [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  question text [not null]
  session_id uuid [not null]
  sources jsonb [not null]
  indexes {
    (id) [name: 'PK_chat_history', pk]
    (session_id, created_at, id) [name: 'ix_chat_history_session_created']
  }
  checks {
    `(length(btrim(answer)) > 0)` [name: 'ck_chat_history_answer']
    `((answer_basis)::text = ANY ((ARRAY['course'::character varying, 'model_knowledge'::character varying, 'course_and_model_knowledge'::character varying])::text[]))` [name: 'ck_chat_history_basis']
    `(length(btrim(question)) > 0)` [name: 'ck_chat_history_question']
  }
}

Table ai.chat_sessions {
  id uuid [not null]
  course_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  user_id varchar(128) [not null]
  indexes {
    (id) [name: 'PK_chat_sessions', pk]
    (user_id, course_id) [name: 'ux_chat_sessions_user_course', unique]
  }
  checks {
    `(course_id > 0)` [name: 'ck_chat_sessions_course']
    `(length(btrim((user_id)::text)) > 0)` [name: 'ck_chat_sessions_user']
  }
}

Table ai.course_reindex_outbox {
  id bigint [not null, increment]
  attempt_count integer [not null]
  completed_at "timestamp with time zone"
  course_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  last_error varchar(2000)
  lease_until "timestamp with time zone"
  next_attempt_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  reason varchar(64) [not null]
  remote_generation_id uuid
  remote_job_id uuid
  started_at "timestamp with time zone"
  status varchar(16) [not null]
  indexes {
    (id) [name: 'PK_course_reindex_outbox', pk]
    (status, next_attempt_at, id) [name: 'ix_course_reindex_outbox_claim']
    (course_id, status) [name: 'ix_course_reindex_outbox_course_status']
  }
  checks {
    `(attempt_count >= 0)` [name: 'ck_course_reindex_outbox_attempts']
    `(course_id > 0)` [name: 'ck_course_reindex_outbox_course']
    `((status)::text = ANY ((ARRAY['pending'::character varying, 'processing'::character varying, 'succeeded'::character varying, 'failed'::character varying])::text[]))` [name: 'ck_course_reindex_outbox_status']
  }
}

