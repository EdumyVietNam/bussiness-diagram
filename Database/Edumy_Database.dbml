  UpdatedAt "timestamp with time zone"
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_CourseComments', pk]
    (CourseId) [name: 'IX_CourseComments_CourseId']
    (ParentCommentId) [name: 'IX_CourseComments_ParentCommentId']
    (UserId) [name: 'IX_CourseComments_UserId']
    (UserId, CourseId) [name: 'UX_CourseComments_UserRating', unique, note: 'Filter: (("ParentCommentId" IS NULL) AND ("Rating" IS NOT NULL) AND ("Status" <> \'-1\'::integer))']
  }
}

