Table public.ExamAttempts {
  Id integer [not null, increment]
  Code varchar(50)
  CreatedAt "timestamp with time zone" [not null]
  CreatedBy varchar(255)
  Description text
  ExamId integer [not null]
  IsDefault boolean
  Name varchar(255)
  PassingScoreSnapshot numeric(18,2)
  Score numeric(18,2)
  SortOrder integer
  StartAt "timestamp with time zone" [not null]
  Status integer [not null]
  SubmitAt "timestamp with time zone"
  TotalCorrect integer
  TotalQuestions integer
  UpdatedAt "timestamp with time zone"
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_ExamAttempts', pk]
    (ExamId) [name: 'IX_ExamAttempts_ExamId']
    (UserId) [name: 'IX_ExamAttempts_UserId']
  }
  checks {
    `(("PassingScoreSnapshot" IS NULL) OR (("PassingScoreSnapshot" >= (0)::numeric) AND ("PassingScoreSnapshot" <= (10)::numeric)))` [name: 'CK_ExamAttempts_PassingScoreSnapshot_Range']
    `(("Score" IS NULL) OR (("Score" >= (0)::numeric) AND ("Score" <= (10)::numeric)))` [name: 'CK_ExamAttempts_Score_Range']
  }
}

Table public.ExamComments [note: 'Partial unique rating index UX_ExamComments_UserRating applies to top-level active ratings.'] {
  Id integer [not null, increment]
  Code varchar(50)
