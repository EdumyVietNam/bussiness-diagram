// EDUMY database diagram — verified against live PostgreSQL on 2026-11-02.
// Source: SystemManagementModule Development connection; schema metadata only (read-only).
// Includes 65 tables and 94 foreign keys across public and ai.
// __EFMigrationsHistory is omitted as EF infrastructure. Partial-index predicates are recorded in notes.
Project EdumySystemManagement {
  database_type: 'PostgreSQL'
}

Table public.AspNetRoles {
  Id text [not null]
  Name varchar(256)
  NormalizedName varchar(256)
  ConcurrencyStamp text
  indexes {
    (Id) [name: 'PK_AspNetRoles', pk]
    (NormalizedName) [name: 'RoleNameIndex', unique]
  }
}

Table public.AspNetRoleClaims {
  Id integer [not null, increment]
  RoleId text [not null]
  ClaimType text
  ClaimValue text
  indexes {
    (Id) [name: 'PK_AspNetRoleClaims', pk]
    (RoleId) [name: 'IX_AspNetRoleClaims_RoleId']
  }
}

Table public.AspNetUserClaims {
  Id integer [not null, increment]
  UserId text [not null]
  ClaimType text
  ClaimValue text
  indexes {
    (Id) [name: 'PK_AspNetUserClaims', pk]
    (UserId) [name: 'IX_AspNetUserClaims_UserId']
  }
}

Table public.AspNetUserLogins {
  LoginProvider text [not null]
  ProviderKey text [not null]
  ProviderDisplayName text
  UserId text [not null]
  indexes {
    (LoginProvider, ProviderKey) [name: 'PK_AspNetUserLogins', pk]
    (UserId) [name: 'IX_AspNetUserLogins_UserId']
  }
}

Table public.AspNetUserRoles {
  UserId text [not null]
  RoleId text [not null]
  indexes {
    (UserId, RoleId) [name: 'PK_AspNetUserRoles', pk]
    (RoleId) [name: 'IX_AspNetUserRoles_RoleId']
  }
}

Table public.AspNetUserTokens {
  UserId text [not null]
  LoginProvider text [not null]
  Name text [not null]
  Value text
  indexes {
    (UserId, LoginProvider, Name) [name: 'PK_AspNetUserTokens', pk]
  }
}

Table ai.chunks [note: 'PostgreSQL-only AI table; embedding is vector(768).'] {
  id uuid [not null]
  chunk_index integer [not null]
  content text [not null]
  content_hash varchar(64) [not null]
  course_id integer [not null]
  course_title text [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  embedding vector(768) [not null]
  generation_id uuid [not null]
  heading text
  lesson_id integer
  lesson_title text
  section_id integer
  section_title text
  source_id integer [not null]
  source_type varchar(24) [not null]
  indexes {
    (id) [name: 'PK_chunks', pk]
    (course_id, generation_id) [name: 'ix_chunks_course_generation']
    (course_id, generation_id, source_type, source_id, chunk_index) [name: 'ux_chunks_source_position', unique]
  }
  checks {
    `(length(btrim(content)) > 0)` [name: 'ck_chunks_content']
    `((source_id > 0) AND (chunk_index >= 0))` [name: 'ck_chunks_source']
    `((source_type)::text = ANY ((ARRAY['course_metadata'::character varying, 'section_metadata'::character varying, 'lesson_metadata'::character varying, 'article'::character varying])::text[]))` [name: 'ck_chunks_source_type']
  }
}

Table ai.course_indexes [note: 'PostgreSQL-only AI table; active generation is unique per course.'] {
  course_id integer [not null]
  generation_id uuid [not null]
  chunking_version varchar(64) [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  embedding_digest varchar(64) [not null]
  embedding_dimension integer [not null, default: `768`]
  embedding_model varchar(200) [not null]
  is_active boolean [not null, default: `false`]
  normalization_version varchar(64) [not null]
  prefix_version varchar(64) [not null]
  source_fingerprint varchar(64) [not null]
  status varchar(16) [not null]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (course_id, generation_id) [name: 'PK_course_indexes', pk]
    (course_id) [name: 'ux_course_indexes_active_course', unique, note: 'Filter: is_active']
  }
  checks {
    `((NOT is_active) OR ((status)::text = 'ready'::text))` [name: 'ck_course_indexes_active_ready']
    `(course_id > 0)` [name: 'ck_course_indexes_course']
    `(embedding_dimension = 768)` [name: 'ck_course_indexes_dimension']
    `((status)::text = ANY ((ARRAY['building'::character varying, 'ready'::character varying, 'failed'::character varying, 'interrupted'::character varying])::text[]))` [name: 'ck_course_indexes_status']
  }
}

Table ai.reindex_jobs [note: 'PostgreSQL-only AI table; one queued/running job per course.'] {
  id uuid [not null]
  chunk_count integer [not null]
  course_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  error_code varchar(100)
  finished_at "timestamp with time zone"
  generation_id uuid [not null]
  source_count integer [not null]
  started_at "timestamp with time zone"
  status varchar(16) [not null]
  indexes {
    (id) [name: 'PK_reindex_jobs', pk]
    (course_id, generation_id) [name: 'ix_reindex_jobs_course_generation']
    (status, created_at) [name: 'ix_reindex_jobs_status_created']
    (course_id) [name: 'ux_reindex_jobs_in_progress', unique, note: 'Filter: ((status)::text = ANY ((ARRAY[\'queued\'::character varying, \'running\'::character varying])::text[]))']
  }
  checks {
    `((source_count >= 0) AND (chunk_count >= 0))` [name: 'ck_reindex_jobs_counts']
    `((status)::text = ANY ((ARRAY['queued'::character varying, 'running'::character varying, 'completed'::character varying, 'failed'::character varying, 'interrupted'::character varying])::text[]))` [name: 'ck_reindex_jobs_status']
  }
}

