  database_type: 'PostgreSQL'
}

Table public.CourseEssayAssignments {
  Id integer [not null, increment]
  CourseId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  Description text
  Name varchar(255)
  PublicUrl varchar(1000)
  Status integer [not null]
  indexes {
    (Id) [name: 'PK_CourseEssayAssignments', pk]
  }
  Note: "Conditional/expression uniqueness: (CourseId) [name: 'IX_CourseEssayAssignments_CourseId', unique, note: 'Filter: (\"Status\" <> \\'-1\\'::integer)']\nCheck: `((\"PublicUrl\" IS NULL) OR (length(TRIM(BOTH FROM \"PublicUrl\")) > 0))` [name: 'CK_CourseEssayAssignments_PublicUrl']"
}

Table public.CourseEssaySubmissions {
  Id integer [not null, increment]
  AssignmentId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  GradedAt "timestamp with time zone"
  GradedBy varchar(36)
  GradingNote text
  GradingResult integer [not null, default: `0`]
  Score numeric(4,2)
  Status integer [not null]
  StudentId varchar(36) [not null]
  SubmissionUrl varchar(1000) [not null]
  indexes {
    (Id) [name: 'PK_CourseEssaySubmissions', pk]
  }
  Note: "Conditional/expression uniqueness: (AssignmentId, StudentId) [name: 'UX_CourseEssaySubmissions_OnePending', unique, note: 'Filter: ((\"GradingResult\" = 0) AND (\"Status\" <> \\'-1\\'::integer))']\nCheck: `(((\"GradingResult\" = 0) AND (\"GradedBy\" IS NULL) AND (\"GradedAt\" IS NULL) AND (\"Score\" IS NULL)) OR ((\"GradingResult\" = ANY (ARRAY[1, 2])) AND (\"GradedBy\" IS NOT NULL) AND (\"GradedAt\" IS NOT NULL)))` [name: 'CK_CourseEssaySubmissions_Grading']\nCheck: `((\"Score\" IS NULL) OR ((\"Score\" >= (0)::numeric) AND (\"Score\" <= (10)::numeric)))` [name: 'CK_CourseEssaySubmissions_Score']\nCheck: `(length(TRIM(BOTH FROM \"SubmissionUrl\")) > 0)` [name: 'CK_CourseEssaySubmissions_Url']"
}

Table public.Certificates {
  Id integer [not null, increment]
  CertificateNumber varchar(50)
  CertificateUrl varchar(1000)
  CourseId integer
  CreatedAt "timestamp with time zone" [not null]
  ExamId integer
  IssuedAt "timestamp with time zone" [not null]
  Status integer [not null]
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_Certificates', pk]
    (CertificateNumber) [name: 'IX_Certificates_CertificateNumber', unique]
  }

}

