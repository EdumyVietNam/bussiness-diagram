Project EdumyPayment {
  database_type: 'PostgreSQL'
}

Table public.PaymentOrders {
  Id integer [not null, increment]
  AccountNumber varchar(50)
  BankName varchar(50)
  CancelledAt "timestamp with time zone"
  Code varchar(50)
  CreatedAt "timestamp with time zone" [not null]
  DiscountAmount numeric(18,2) [not null]
  ExpiredAt "timestamp with time zone"
  ItemsComplete boolean [not null, default: `false`]
  OrderStatus integer [not null]
  PaidAt "timestamp with time zone"
  RequestFingerprint varchar(128)
  RequestId uuid
  Status integer [not null]
  SubTotal numeric(18,2) [not null]
  TotalAmount numeric(18,2) [not null]
  UserId varchar(36) [not null]
  VoucherCodeSnapshot varchar(100)
  VoucherId integer
  indexes {
    (Id) [name: 'PK_PaymentOrders', pk]
    (Code) [name: 'IX_PaymentOrders_Code', unique]
  }
  Note: "Conditional/expression uniqueness: (UserId, RequestId) [name: 'IX_PaymentOrders_UserId_RequestId', unique, note: 'Filter: (\"RequestId\" IS NOT NULL)']"
}

Table public.PaymentOrderItems [note: 'ItemType + ItemId is a polymorphic product snapshot without direct product FK.'] {
  PaymentOrderId integer [not null]
  ItemType integer [not null]
  ItemId integer [not null]
  CreatorIdSnapshot varchar(36)
  DiscountAmount numeric(18,2)
  NetAmount numeric(18,2)
  Title text [not null]
  UnitPrice numeric(18,2)
  indexes {
    (PaymentOrderId, ItemType, ItemId) [name: 'PK_PaymentOrderItems', pk]
  }
}

Table public.PaymentTransactions {
  Id integer [not null, increment]
  AccountNumber varchar(50)
  Content varchar(500)
  CreatedAt "timestamp with time zone" [not null]
  Gateway varchar(50)
  GatewayTransactionId varchar(50) [not null]
  PaymentCode varchar(100)
  PaymentOrderId integer
  ProcessStatus integer [not null]
  ProcessedAt "timestamp with time zone"
  ReferenceCode varchar(100)
  Status integer [not null]
  SubAccount varchar(50)
  TransactionDate "timestamp with time zone"
  TransferAmount numeric(18,2) [not null]
  TransferType varchar(10)
  indexes {
    (Id) [name: 'PK_PaymentTransactions', pk]
    (GatewayTransactionId) [name: 'IX_PaymentTransactions_GatewayTransactionId', unique]
  }
}

