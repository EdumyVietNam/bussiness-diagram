  indexes {
    (UserId, RoleId) [name: 'PK_AspNetUserRoles', pk]
  }
}

Table public.AspNetUserTokens {
  UserId text [not null]
  LoginProvider text [not null]
  Name text [not null]
  Value text
  indexes {
    (UserId, LoginProvider, Name) [name: 'PK_AspNetUserTokens', pk]
  }
}

Table public.UserActionTokens {
  Id integer [not null, increment]
