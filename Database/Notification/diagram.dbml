// Simplified reading diagram; not a full migration schema.
// Primary tables own the domain; reference tables provide local context.
Project EdumyNotification {
  database_type: 'PostgreSQL'
}

Table public.Notifications {
  Id integer [not null, increment]
  ActionUrl varchar(1000)
  Content text [not null]
  CreatedAt "timestamp with time zone" [not null]
  EntityId integer
  EntityType varchar(50)
  EventKey varchar(200)
  IsGlobal boolean [not null]
  NotificationTypeId integer [not null]
  Status integer [not null]
  TemplateData jsonb
  Title varchar(500) [not null]
  indexes {
    (Id) [name: 'PK_Notifications', pk]
    (EventKey) [name: 'IX_Notifications_EventKey', unique]
  }
}

Table public.UserNotifications {
  UserId varchar(36) [not null]
  NotificationId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  IsRead boolean [not null]
  ReadAt "timestamp with time zone"
  indexes {
    (UserId, NotificationId) [name: 'PK_UserNotifications', pk]
  }

}

Table public.NotificationOutbox [note: 'Logical references to recipient/entity/notification; migration creates TR_NotificationOutbox_Notify.'] {
  Id bigint [not null, increment]
  ActionUrl varchar(1000)
  AttemptCount integer [not null]
  Content text [not null]
  CreatedAt "timestamp with time zone" [not null]
  DeliveredAt "timestamp with time zone"
  EntityId integer
  EntityType varchar(50)
  EventKey varchar(200) [not null]
  NextAttemptAt "timestamp with time zone" [not null]
  NotificationId integer
  RecipientUserId varchar(450) [not null]
  SourceModule varchar(30) [not null]
  TemplateData jsonb
  Title varchar(500) [not null]
  TypeCode varchar(100) [not null]
  indexes {
    (Id) [name: 'PK_NotificationOutbox', pk]
    (EventKey) [name: 'IX_NotificationOutbox_EventKey', unique]
  }
}

Table public.CAT_NotificationTypes {
  Id integer [not null, increment]
  Code varchar(50)
  Color varchar(50)
  CreatedAt "timestamp with time zone" [not null]
  Description text
  Icon varchar(50)
  Name varchar(255)
  SortOrder integer
  Status integer [not null]
  indexes {
    (Id) [name: 'PK_CAT_NotificationTypes', pk]
    (Code) [name: 'IX_CAT_NotificationTypes_Code', unique]
  }
}

