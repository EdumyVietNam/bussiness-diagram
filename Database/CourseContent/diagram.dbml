// Simplified reading diagram; not a full migration schema.
// Primary tables own the domain; reference tables provide local context.
Project EdumyCourseContent {
  database_type: 'PostgreSQL'
}

Table public.Courses {
  Id integer [not null, increment]
  BusinessStatus integer [not null]
  CourseTypeId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  CreatorId varchar(36) [not null]
  Description text
  HasCertificate boolean [not null, default: `false`]
  Price numeric(18,2) [not null]
  PromotionPrice numeric
  ReviewNote varchar(2000)
  ReviewedAt "timestamp with time zone"
  ReviewedBy varchar(36)
  Status integer [not null]
  SubjectCategoryId integer
  SubmittedAt "timestamp with time zone"
  TagId integer
  ThumbnailUrl varchar(500)
  Title varchar(255) [not null]
  HasEssay boolean [default: `false`]
  indexes {
    (Id) [name: 'PK_Courses', pk]
  }

}

Table public.CourseSections {
  Id integer [not null, increment]
  BusinessStatus integer [not null]
  CompletedLessons integer [not null]
  CourseId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  Description text
  IsRequired boolean [not null]
  Order integer [not null]
  Status integer [not null]
  Title varchar(255) [not null]
  TotalLessons integer [not null]
  indexes {
    (Id) [name: 'PK_CourseSections', pk]
  }
}

Table public.Lessons {
  Id integer [not null, increment]
  BusinessStatus integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  Description text
  Duration integer
  Order integer [not null]
  SectionId integer [not null]
  Status integer [not null]
  Title varchar(255) [not null]
  Type integer [not null]
  indexes {
    (Id) [name: 'PK_Lessons', pk]
  }
}

Table public.Articles {
  Id integer [not null, increment]
  Content text [not null]
  CreatedAt "timestamp with time zone" [not null]
  Description text
  LessonId integer [not null]
  Status integer [not null]
  indexes {
    (Id) [name: 'PK_Articles', pk]
    (LessonId) [name: 'IX_Articles_LessonId', unique]
  }
}

Table public.Videos {
  Id integer [not null, increment]
  CreatedAt "timestamp with time zone" [not null]
  Duration "double precision"
  LessonId integer [not null]
  Status integer [not null]
  Title varchar(255) [not null]
  Url varchar(1000)
  VideoStatus smallint [not null]
  YoutubeEmbed varchar(1000)
  indexes {
    (Id) [name: 'PK_Videos', pk]
    (LessonId) [name: 'IX_Videos_LessonId', unique]
  }
}

Table public.Resources {
  Id integer [not null, increment]
  CreatedAt "timestamp with time zone" [not null]
  Description text
  DocumentTypeId integer
  LessonId integer [not null]
  Status integer [not null]
  Title varchar(255) [not null]
  Url varchar(1000) [not null]
  indexes {
    (Id) [name: 'PK_Resources', pk]
    (LessonId) [name: 'IX_Resources_LessonId', unique]
  }
}

