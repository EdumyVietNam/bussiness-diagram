  }
}


// FeedbackReporting

Table public.CourseComments [note: 'Partial unique rating index UX_CourseComments_UserRating applies to top-level active ratings.'] {
  Id integer [not null, increment]
  Content text [not null]
  CourseId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  ParentCommentId integer
  Rating integer
  Status integer [not null]
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_CourseComments', pk]
  }
  Note: "Conditional/expression uniqueness: UX_CourseComments_UserRating (see original DBML for full definition)."
}

Table public.ExamComments [note: 'Partial unique rating index UX_ExamComments_UserRating applies to top-level active ratings.'] {
  Id integer [not null, increment]
  Content text [not null]
  CreatedAt "timestamp with time zone" [not null]
  ExamId integer [not null]
  ParentCommentId integer
  Rating integer
  Status integer [not null]
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_ExamComments', pk]
  }
  Note: "Conditional/expression uniqueness: UX_ExamComments_UserRating (see original DBML for full definition)."
}

Table public.Reports {
  Id integer [not null, increment]
  Content text [not null]
  CourseId integer
  CreatedAt "timestamp with time zone" [not null]
  ExamId integer
  ReportStatus integer [not null, default: `0`]
  ResolutionNote text
  ResolvedAt "timestamp with time zone"
  ResolvedBy varchar(36)
  Status integer [not null]
  UserId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_Reports', pk]
  }
  Note: "Check constraint: CK_Reports_ExactlyOneTarget (see original DBML for full definition)."
}


// CourseChat

Table public.Conversations {
  Id integer [not null, increment]
  CourseId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  InstructorId varchar(36) [not null]
  LastMessageAt "timestamp with time zone"
  Status integer [not null]
  StudentId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_Conversations', pk]
    (StudentId, InstructorId, CourseId) [name: 'IX_Conversations_StudentId_InstructorId_CourseId', unique]
  }
}

Table public.ChatMessages {
  Id bigint [not null, increment]
  ClientMessageId uuid [not null]
  Content text [not null]
  ConversationId integer [not null]
