  IsRead boolean [not null]
  ReadAt "timestamp with time zone"
  SenderId varchar(36) [not null]
  indexes {
    (Id) [name: 'PK_ChatMessages', pk]
    (SenderId, ClientMessageId) [name: 'IX_ChatMessages_SenderId_ClientMessageId', unique]
  }
}


// Notification

Table public.Notifications {
  Id integer [not null, increment]
  ActionUrl varchar(1000)
  Content text [not null]
  CreatedAt "timestamp with time zone" [not null]
  EntityId integer
  EntityType varchar(50)
  EventKey varchar(200)
  IsGlobal boolean [not null]
  NotificationTypeId integer [not null]
  Status integer [not null]
  TemplateData jsonb
  Title varchar(500) [not null]
  indexes {
    (Id) [name: 'PK_Notifications', pk]
    (EventKey) [name: 'IX_Notifications_EventKey', unique]
  }
}

Table public.UserNotifications {
  UserId varchar(36) [not null]
  NotificationId integer [not null]
  CreatedAt "timestamp with time zone" [not null]
  IsRead boolean [not null]
  ReadAt "timestamp with time zone"
  indexes {
    (UserId, NotificationId) [name: 'PK_UserNotifications', pk]
  }
}

Table public.NotificationOutbox [note: 'Logical references to recipient/entity/notification; migration creates TR_NotificationOutbox_Notify.'] {
  Id bigint [not null, increment]
  ActionUrl varchar(1000)
  AttemptCount integer [not null]
  Content text [not null]
  CreatedAt "timestamp with time zone" [not null]
  DeliveredAt "timestamp with time zone"
  EntityId integer
  EntityType varchar(50)
  EventKey varchar(200) [not null]
  NextAttemptAt "timestamp with time zone" [not null]
  NotificationId integer
  RecipientUserId varchar(450) [not null]
  SourceModule varchar(30) [not null]
  TemplateData jsonb
  Title varchar(500) [not null]
  TypeCode varchar(100) [not null]
  indexes {
    (Id) [name: 'PK_NotificationOutbox', pk]
    (EventKey) [name: 'IX_NotificationOutbox_EventKey', unique]
  }
}

Table public.CAT_NotificationTypes {
  Id integer [not null, increment]
  Code varchar(50)
  Color varchar(50)
  CreatedAt "timestamp with time zone" [not null]
  Description text
  Icon varchar(50)
  Name varchar(255)
  SortOrder integer
  Status integer [not null]
  indexes {
    (Id) [name: 'PK_CAT_NotificationTypes', pk]
    (Code) [name: 'IX_CAT_NotificationTypes_Code', unique]
  }
}


// AiAssistant

Table ai.chunks [note: 'PostgreSQL-only AI table; embedding is vector(768).'] {
  id uuid [not null]
  chunk_index integer [not null]
  content text [not null]
  course_id integer [not null]
  course_title text [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  embedding vector(768) [not null]
  generation_id uuid [not null]
  heading text
  lesson_id integer
  lesson_title text
  section_id integer
  section_title text
  source_id integer [not null]
  source_type varchar(24) [not null]
  indexes {
    (id) [name: 'PK_chunks', pk]
    (course_id, generation_id, source_type, source_id, chunk_index) [name: 'ux_chunks_source_position', unique]
  }
  Note: "Check constraint: ck_chunks_content (see original DBML for full definition).\nCheck constraint: ck_chunks_source (see original DBML for full definition).\nCheck constraint: ck_chunks_source_type (see original DBML for full definition)."
}

Table ai.course_indexes [note: 'PostgreSQL-only AI table; active generation is unique per course.'] {
  course_id integer [not null]
  generation_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  embedding_dimension integer [not null, default: `768`]
  embedding_model varchar(200) [not null]
  is_active boolean [not null, default: `false`]
  status varchar(16) [not null]
  indexes {
    (course_id, generation_id) [name: 'PK_course_indexes', pk]
  }
  Note: "Conditional/expression uniqueness: ux_course_indexes_active_course (see original DBML for full definition).\nCheck constraint: ck_course_indexes_active_ready (see original DBML for full definition).\nCheck constraint: ck_course_indexes_course (see original DBML for full definition).\nCheck constraint: ck_course_indexes_dimension (see original DBML for full definition).\nCheck constraint: ck_course_indexes_status (see original DBML for full definition)."
}

Table ai.reindex_jobs [note: 'PostgreSQL-only AI table; one queued/running job per course.'] {
  id uuid [not null]
  chunk_count integer [not null]
  course_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  error_code varchar(100)
  finished_at "timestamp with time zone"
  generation_id uuid [not null]
  source_count integer [not null]
  started_at "timestamp with time zone"
  status varchar(16) [not null]
  indexes {
    (id) [name: 'PK_reindex_jobs', pk]
  }
  Note: "Conditional/expression uniqueness: ux_reindex_jobs_in_progress (see original DBML for full definition).\nCheck constraint: ck_reindex_jobs_counts (see original DBML for full definition).\nCheck constraint: ck_reindex_jobs_status (see original DBML for full definition)."
}

Table ai.chat_history {
  id uuid [not null]
  answer text [not null]
  answer_basis varchar(32) [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  question text [not null]
  session_id uuid [not null]
  sources jsonb [not null]
  indexes {
    (id) [name: 'PK_chat_history', pk]
  }
  Note: "Check constraint: ck_chat_history_answer (see original DBML for full definition).\nCheck constraint: ck_chat_history_basis (see original DBML for full definition).\nCheck constraint: ck_chat_history_question (see original DBML for full definition)."
}

Table ai.chat_sessions {
  id uuid [not null]
  course_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  user_id varchar(128) [not null]
  indexes {
    (id) [name: 'PK_chat_sessions', pk]
    (user_id, course_id) [name: 'ux_chat_sessions_user_course', unique]
  }
  Note: "Check constraint: ck_chat_sessions_course (see original DBML for full definition).\nCheck constraint: ck_chat_sessions_user (see original DBML for full definition)."
}

Table ai.course_reindex_outbox {
  id bigint [not null, increment]
  attempt_count integer [not null]
  completed_at "timestamp with time zone"
  course_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  next_attempt_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  reason varchar(64) [not null]
  remote_generation_id uuid
  remote_job_id uuid
  started_at "timestamp with time zone"
  status varchar(16) [not null]
  indexes {
    (id) [name: 'PK_course_reindex_outbox', pk]
  }
  Note: "Check constraint: ck_course_reindex_outbox_attempts (see original DBML for full definition).\nCheck constraint: ck_course_reindex_outbox_course (see original DBML for full definition).\nCheck constraint: ck_course_reindex_outbox_status (see original DBML for full definition)."
}


